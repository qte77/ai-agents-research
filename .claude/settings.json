{
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "Generated with Claude <noreply@anthropic.com>"
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "permissions": {
    "allow": [
      "Bash(lychee --config *)",
      "Bash(markdownlint-cli2 --config *)",
      "ListAgents",
      "Bash(lychee *)",
      "Bash(actionlint *)",
      "Bash(npm view *)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make check_docs)",
      "Bash(make check_links)",
      "Bash(make reconcile)",
      "Bash(make check_status)",
      "Bash(make check_actions)",
      "Bash(make help)",
      "Bash(make census)",
      "Bash(shellcheck *)",
      "Bash(~/.local/bin/lychee *)",
      "Bash(gh run watch *)",
      "Bash(gh secret list *)",
      "Bash(gh search prs *)",
      "Bash(gh label list *)",
      "mcp__plugin_cloudflare_cloudflare-docs__search_cloudflare_documentation"
    ]
  },
  "enabledPlugins": {
    "commit-helper@qte77-claude-code-plugins": true,
    "docs-governance@qte77-claude-code-plugins": true,
    "python-dev@qte77-claude-code-plugins": true,
    "tdd-core@qte77-claude-code-plugins": true,
    "gha-dev@qte77-claude-code-plugins": true
  },
  "extraKnownMarketplaces": {
    "qte77-claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "qte77/claude-code-plugins"
      }
    }
  }
}
